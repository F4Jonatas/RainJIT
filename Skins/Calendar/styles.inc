[segoe-font]
	fontFace = "Segoe UI"

[segoe-semibold-font]
	fontFace = "Segoe UI SemiBold"

[segoe-icons-font]
	fontFace = "Segoe Fluent Icons"

[lbltxtsty]
	x           = ( #MARGIN_LEFT# + #CELL_W# )r
	y           = r
	w           = #CELL_W#
	h           = #CELL_H#
	fontColor   = 170,170,170,100
	; solidColor  = 255,255,255,60
	fontSize    = 9
	stringAlign = centerCenter
	antialias   = 1

[textstyle]
	x           = ( #MARGIN_LEFT# + #CELL_W# )r
	y           = r
	w           = #CELL_W#
	h           = #CELL_H#
	fontColor   = 255,255,255,220
	fontSize    = 10
	stringAlign = centerCenter
	antiAlias   = 1
	; solidColor  = 255,0,0,60


[currentday]
	fontFace    = "Segoe UI SemiBold"
	fontColor   = 0,0,0

; [NewWk]
; 	solidColor = 255,0,0,20

[LastWeek]
	fontColor=0,0,0,0

[previousmonth]
	fontColor = #FONT_VIBRANT#

[nextmonth]
	fontColor = #FONT_VIBRANT#

[holidaystyle]
	fontColor=170,170,170,100

[bold]
	stringStyle = bold
