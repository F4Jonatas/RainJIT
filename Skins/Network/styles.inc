
[text-white]
	fontColor = 255,255,255,220

[paused]
	updateDivider = -1

[segoe-font]
	fontFace = "Segoe UI"

[segoe-semibold-font]
	fontFace = "Segoe UI SemiBold"

[segoe-icons-font]
	fontFace = "Segoe Fluent Icons"

[antialias]
	antialias = 1

[align-center]
	stringAlign = centerCenter

[align-left]
	stringAlign = leftCenter

[align-right]
	stringAlign = rightCenter
