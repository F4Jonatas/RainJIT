
[text-white]
	fontColor = 255,255,255

[font-size-12]
	fontSize = 12

[paused]
	updateDivider = -1

[bold]
	stringStyle = bold

[font-rFont]
	fontFace = rFont

[antialias]
	antialias = 1

[dynamic]
	dynamicVariables = 1

[align-center]
	stringAlign = centerCenter

[align-left]
	stringAlign = leftCenter

[align-right]
	stringAlign = rightCenter

[segoe-font]
	fontFace = "Segoe UI"

[segoe-semibold-font]
	fontFace = "Segoe UI SemiBold"

[segoe-icons-font]
	fontFace = "Segoe Fluent Icons"

[font-shadow]
	inlinePattern = (.+)
	inlineSetting = shadow | 0 | 0 | 3.5 | 0,0,0,200
